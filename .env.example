# Copy this file to .env.local and fill in the values from your Supabase project.
# The publishable key is intended for browser use. Never put a secret/service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# For GitHub Pages project sites, set this to your repository path, e.g. /sportstack/.
# Leave as / for localhost or a root/custom domain.
VITE_BASE_PATH=/
